# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Required: the PIN you'll type to approve unlocking doors, opening the garage
# and disarming the alarm. Use 6+ digits that aren't your birthday.
JARVIS_PIN=

# Home Assistant. Leave these empty to use the simulated house.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Only if your alarm panel in Home Assistant requires a code to arm/disarm.
ALARM_CODE=

# Web server
PORT=3000
